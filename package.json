{
  "name": "xml2jianpu-vue",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:pages": "PUBLIC_PATH=/xml2jianpu/ vite build",
    "preview": "vite preview",
    "lint": "eslint --ext .js,.vue src",
    "font:woff2": "node scripts/build-score-font.mjs",
    "icon:macos": "node scripts/build-macos-icon.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:dev:warm": "vite optimize && tauri dev",
    "tauri:build": "tauri build",
    "pretauri:build": "node scripts/clean-bundles.mjs",
    "posttauri:build": "node scripts/repack-linux-opt.mjs && node scripts/rename-bundles.mjs",
    "bundle:clean": "node scripts/clean-bundles.mjs",
    "bundle:rename": "node scripts/rename-bundles.mjs",
    "tauri:android:dev": "tauri android dev",
    "tauri:android:build": "tauri android build",
    "tauri:ios:dev": "tauri ios dev",
    "tauri:ios:build": "tauri ios build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-fs": "^2.4.5",
    "core-js": "^3.8.3",
    "d3-selection": "^3.0.0",
    "fast-xml-parser": "^4.0.12",
    "jspdf": "^4.2.1",
    "svg2pdf.js": "^2.7.0",
    "vue": "^3.2.13",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.12.16",
    "@resvg/resvg-js": "^2.6.2",
    "@tauri-apps/cli": "^2.10.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "eslint": "^7.32.0",
    "eslint-plugin-vue": "^8.0.3",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^0.21.2"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true,
      "es2021": true
    },
    "extends": [
      "plugin:vue/vue3-essential",
      "eslint:recommended"
    ],
    "parserOptions": {
      "parser": "@babel/eslint-parser",
      "requireConfigFile": false,
      "ecmaVersion": 2021,
      "sourceType": "module"
    },
    "rules": {},
    "globals": {
      "__PWA_ENABLED__": "readonly"
    }
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "iOS >= 11",
    "Safari >= 11",
    "not ie 11"
  ]
}
