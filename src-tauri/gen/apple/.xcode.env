# Sourced by the Xcode "Build Rust Code" phase.
# Xcode.app does not load ~/.zshrc, so nvm / Homebrew / cargo are missing from PATH.
export PATH="${HOME}/.cargo/bin:/opt/homebrew/bin:/usr/local/bin:${PATH}"
if [ -d "${HOME}/.nvm/versions/node" ]; then
  _nvm_node="$(ls -1d "${HOME}/.nvm/versions/node"/v* 2>/dev/null | sort -V | tail -1)"
  if [ -n "${_nvm_node}" ]; then
    export PATH="${_nvm_node}/bin:${PATH}"
  fi
  unset _nvm_node
fi

# iPhone localhost is the phone. Embed this Mac's LAN IP into the debug binary.
# Override in .xcode.env.local if needed (USB TUN IPv6, another NIC, etc.).
if [ -z "${TAURI_DEV_HOST}" ]; then
  TAURI_DEV_HOST="$(ipconfig getifaddr en0 2>/dev/null || true)"
  if [ -z "${TAURI_DEV_HOST}" ]; then
    TAURI_DEV_HOST="$(ipconfig getifaddr en1 2>/dev/null || true)"
  fi
  if [ -z "${TAURI_DEV_HOST}" ]; then
    _iface="$(route -n get default 2>/dev/null | awk '/interface:/{print $2; exit}')"
    if [ -n "${_iface}" ]; then
      TAURI_DEV_HOST="$(ipconfig getifaddr "${_iface}" 2>/dev/null || true)"
    fi
    unset _iface
  fi
fi
if [ -n "${TAURI_DEV_HOST}" ]; then
  export TAURI_DEV_HOST
  if [ -z "${TAURI_CONFIG}" ]; then
    export TAURI_CONFIG="{\"build\":{\"devUrl\":\"http://${TAURI_DEV_HOST}:5173\"}}"
  fi
fi

if [ -f "${SRCROOT}/.xcode.env.local" ]; then
  . "${SRCROOT}/.xcode.env.local"
fi
